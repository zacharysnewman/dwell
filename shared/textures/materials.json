{
  "$comment": "The painterly materials (docs/PAINTERLY_TEXTURES.md, ADR 0040; style in docs/ART_DIRECTION.md): each is a stack of layers painted into a 32 × 32 tile by shared/textures/paint.mjs, with colours from shared/textures/palette.json (\"ramp.stop\", a swatch, or \"@stop\" for the material's own ramp). `tiles` maps every atlas tile (the block registry's texture names, and the engine's utility tiles `plain` and `missing`) to the material that paints it; the utility tiles (`plain`, `grid`, `missing`) are not content. `like` starts from another material's fields (a template); `over` paints another material first. Coordinates are texels, y up (y = 32 is the tile's top); angles in degrees, 0 = +x, 90 = up. Run `node shared/textures/gen.mjs` after editing; CI fails if the baked tiles are stale. Edit live with docs/prototypes/painterly-texture-lab.html. The content is the first art direction, still prototype in scope (ARCHITECTURE.md §6.1).",
  "tileSize": 32,
  "tiles": {
    "grass": "grass_top",
    "grassSide": "grass_side",
    "dirt": "soil",
    "stone": "stone",
    "sand": "sand",
    "water": "water",
    "logSide": "bark",
    "logTop": "log_end",
    "leaves": "leaves",
    "tallGrass": "tall_grass",
    "ladder": "ladder_wood",
    "dirtSkirt": "dirt_skirt",
    "torch": "torch",
    "torchTop": "torch_top",
    "plain": "plain",
    "grid": "grid",
    "missing": "missing"
  },
  "materials": {
    "plain": {
      "$comment": "A utility tile, not content: white, which an untextured state's colour tints.",
      "use": "block", "ramp": "chalk",
      "layers": [{ "kind": "fill", "color": "@base" }]
    },
    "grid": {
      "$comment": "A utility tile, not content (the sandbox floor): white with a faint one-texel line along the bottom and left edges, so every block edge gets one line from the block on its positive side; mipmapping fades it with distance. The shader's grid look option rules the larger cells.",
      "use": "block", "ramp": "chalk",
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "edgeLight", "edge": "bottom", "color": "@shadow", "width": 1 },
        { "kind": "edgeLight", "edge": "left", "color": "@shadow", "width": 1 }
      ]
    },
    "missing": {
      "$comment": "A utility tile, never content: the fallback look of a state whose look or textures this build lacks (synced from a server, ADR 0038). Magenta and black squares, 4 × 4 per tile, so it can't be mistaken for anything painted.",
      "use": "block", "ramp": "chalk", "wrap": false,
      "layers": [
        { "kind": "fill", "color": "missing_black" },
        { "kind": "slab", "colors": ["missing_magenta"], "width": 8, "length": 8, "angle": 0, "softness": 0.25,
          "at": [[4, 4], [20, 4], [12, 12], [28, 12], [4, 20], [20, 20], [12, 28], [28, 28]] }
      ]
    },
    "grass_top": {
      "use": "block", "ramp": "meadow", "overlay": 1,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "dab", "count": 7, "colors": ["@shadow"], "width": [7, 10], "length": [11, 15], "angle": 25, "angleJitter": 40, "opacity": 0.28, "softness": 3 },
        { "kind": "dab", "count": 8, "colors": ["@light"], "width": [4, 6], "length": [8, 12], "angle": 30, "angleJitter": 30, "opacity": 0.32, "softness": 2 },
        { "kind": "blade", "count": 14, "colors": ["@light", "@base"], "width": [1.8, 2.4], "length": [4, 6], "angle": 70, "angleJitter": 25, "bend": [-1, 1], "opacity": 0.3, "seed": 3 }
      ]
    },
    "soil": {
      "use": "block", "ramp": "soil", "overlay": 1,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "dab", "count": 8, "colors": ["@shadow"], "width": [6, 9], "length": [8, 12], "angle": 10, "angleJitter": 30, "opacity": 0.4, "softness": 2.5 },
        { "kind": "dab", "count": 7, "colors": ["@light"], "width": [3, 5], "length": [5, 8], "angle": 10, "angleJitter": 20, "opacity": 0.35, "softness": 1.5 },
        { "kind": "slab", "count": 3, "colors": ["@light"], "width": [2, 2.5], "length": [3, 4], "angle": 15, "angleJitter": 40, "opacity": 0.45, "seed": 5 }
      ]
    },
    "grass_side": {
      "$comment": "Soil with a hanging skirt of turf: a band of meadow at the top, and darker and lighter drips rooted inside it all along the width (an uneven hem that wraps, so side-by-side blocks join into one skirt), and a painted light along the rim.",
      "use": "block", "ramp": "meadow", "overlay": 1, "over": "soil",
      "layers": [
        { "kind": "blade", "count": 9, "band": [0.76, 0.8], "colors": ["@shadow"], "width": [3.5, 5], "length": [5, 11], "angle": -90, "angleJitter": 8, "bend": [-1, 1], "opacity": 0.85, "seed": 4 },
        { "kind": "edgeLight", "edge": "top", "color": "@base", "width": 8, "ragged": 1, "seed": 1 },
        { "kind": "blade", "count": 11, "band": [0.78, 0.82], "colors": ["@base"], "width": [3, 4.5], "length": [4, 9], "angle": -90, "angleJitter": 8, "bend": [-1, 1], "seed": 9 },
        { "kind": "dab", "count": 5, "band": [0.84, 0.95], "colors": ["@light"], "width": [2, 3], "length": [5, 8], "angle": 0, "angleJitter": 15, "opacity": 0.35 },
        { "kind": "edgeLight", "edge": "top", "color": "@light", "width": 2, "ragged": 0.8, "opacity": 0.6, "seed": 2 }
      ]
    },
    "dirt_skirt": {
      "$comment": "A dirt side with grass directly above it (dirt's sideUnder in shared/blocks/dwell.json): the grass side's skirt, the same strokes, so the turf hangs over the dirt face below a grass slope and lines up with a grass side beside it. Its own tile, so it can diverge by data.",
      "like": "grass_side"
    },
    "stone": {
      "$comment": "Broad faceted planes, not speckle: a few big flat-ended slabs in the shadow and light of the ramp, and a couple of long crack lines.",
      "use": "block", "ramp": "stone", "overlay": 1,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "slab", "count": 5, "colors": ["@shadow"], "width": [7, 10], "length": [11, 16], "angle": 0, "angleJitter": 24, "opacity": 0.38, "softness": 1.5 },
        { "kind": "slab", "count": 6, "colors": ["@light"], "width": [4, 6], "length": [8, 12], "angle": 0, "angleJitter": 24, "opacity": 0.42, "softness": 1.2, "seed": 1 },
        { "kind": "streak", "count": 3, "colors": ["@shadow"], "width": [1.2, 1.6], "length": [9, 14], "angle": 15, "angleJitter": 35, "opacity": 0.55, "seed": 2 }
      ]
    },
    "sand": {
      "use": "block", "ramp": "sand", "overlay": 1,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "streak", "count": 7, "colors": ["@light"], "width": [2.5, 3.5], "length": [12, 20], "angle": 0, "angleJitter": 7, "bend": [-1.5, 1.5], "opacity": 0.5 },
        { "kind": "streak", "count": 6, "colors": ["@shadow"], "width": [1.5, 2.2], "length": [10, 16], "angle": 0, "angleJitter": 7, "bend": [-1.5, 1.5], "opacity": 0.3, "seed": 1 }
      ]
    },
    "water": {
      "use": "block", "ramp": "water", "overlay": 1,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "streak", "count": 6, "colors": ["@shadow"], "width": [3, 5], "length": [14, 22], "angle": 0, "angleJitter": 8, "bend": [-2, 2], "opacity": 0.3, "softness": 2 },
        { "kind": "streak", "count": 7, "colors": ["@light"], "width": [1.4, 2.2], "length": [6, 12], "angle": 0, "angleJitter": 8, "bend": [-1, 1], "opacity": 0.55, "seed": 1 }
      ]
    },
    "bark": {
      "use": "block", "ramp": "bark", "overlay": 1,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "streak", "count": 9, "colors": ["@shadow"], "width": [2, 3], "length": [18, 30], "angle": 90, "angleJitter": 4, "bend": [-1, 1], "opacity": 0.6 },
        { "kind": "streak", "count": 7, "colors": ["@light"], "width": [1.5, 2.2], "length": [10, 18], "angle": 90, "angleJitter": 4, "opacity": 0.45, "seed": 1 }
      ]
    },
    "log_end": {
      "use": "block", "ramp": "heartwood", "overlay": 1, "wrap": false,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "dab", "at": [[16, 16]], "colors": ["@light"], "width": 16, "length": 16, "opacity": 0.4, "softness": 5 },
        { "kind": "ring", "at": [[16, 16, 3.5], [16, 16, 7.5], [16, 16, 11]], "colors": ["@shadow"], "width": 1.4, "length": 1, "arc": 300, "angle": 60, "angleJitter": 180, "opacity": 0.55 },
        { "kind": "edgeLight", "edge": "all", "color": "bark.base", "width": 2.6, "ragged": 0.5 },
        { "kind": "edgeLight", "edge": "all", "color": "bark.shadow", "width": 1, "opacity": 0.6, "seed": 1 }
      ]
    },
    "leaves": {
      "$comment": "Big leaf clusters with gaps (cut out); the light dabs lean the same way so the canopy reads as lit from above.",
      "use": "block", "ramp": "leaf", "overlay": 1, "alpha": "strokes",
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "dab", "count": 12, "colors": ["@shadow", "@base"], "width": [8, 10], "length": [10, 13], "angle": 35, "angleJitter": 40, "softness": 1 },
        { "kind": "dab", "count": 9, "colors": ["@base"], "width": [5, 7], "length": [7, 10], "angle": 40, "angleJitter": 30, "opacity": 0.8, "clip": true, "seed": 1 },
        { "kind": "dab", "count": 7, "colors": ["@light"], "width": [3, 4], "length": [5, 7], "angle": 45, "angleJitter": 20, "opacity": 0.75, "clip": true, "seed": 2 }
      ]
    },
    "tall_grass": {
      "$comment": "A sprite on crossed quads, so it does not wrap: blades rooted on the bottom row, inside the side columns, tips under the top row; dark at the foot, light at the tips.",
      "use": "block", "ramp": "meadow", "overlay": 1, "alpha": "strokes", "wrap": false,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "blade", "at": [[5.5, 0, 21], [7.5, 0, 28], [9.5, 0, 16], [11, 0, 24], [13, 0, 12], [14.5, 0, 29], [16.5, 0, 19], [18, 0, 26], [20, 0, 14], [21.5, 0, 27], [23.5, 0, 18], [25, 0, 23], [26.5, 0, 15]], "colors": ["@base", "@shadow", "@light"], "width": [2.2, 3], "length": 1, "angle": 90, "angleJitter": 7, "bend": [-3, 3], "softness": 2 },
        { "kind": "gradient", "from": "@shadow", "to": "@light", "direction": "up", "opacity": 0.55, "clip": true }
      ]
    },
    "ladder_wood": {
      "use": "block", "ramp": "heartwood", "overlay": 1, "alpha": "strokes",
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "slab", "at": [[5, 16, 40], [27, 16, 40]], "colors": ["@base"], "width": 4, "length": 1, "angle": 90, "softness": 0.5 },
        { "kind": "slab", "at": [[16, 3.5, 22], [16, 11.5, 22], [16, 19.5, 22], [16, 27.5, 22]], "colors": ["@base"], "width": 3, "length": 1, "angle": 0, "softness": 0.5 },
        { "kind": "slab", "at": [[16, 2.4, 22], [16, 10.4, 22], [16, 18.4, 22], [16, 26.4, 22]], "colors": ["@shadow"], "width": 1, "length": 1, "angle": 0, "opacity": 0.6, "clip": true },
        { "kind": "streak", "at": [[4.3, 16, 30], [26.3, 16, 30]], "colors": ["@light"], "width": 1.3, "length": 1, "angle": 90, "opacity": 0.6, "clip": true },
        { "kind": "slab", "at": [[6.6, 16, 40], [28.6, 16, 40]], "colors": ["@shadow"], "width": 0.9, "length": 1, "angle": 90, "opacity": 0.5, "clip": true }
      ]
    },

    "torch": {
      "$comment": "A sprite on crossed quads (docs/LIGHTS.md): the 1 m torch's lower cell, a plain stick of bark rooted on the bottom row and running out of the top (it goes on in torch_top).",
      "use": "block", "ramp": "bark", "alpha": "strokes", "wrap": false,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "slab", "at": [[16, 16, 34]], "colors": ["@base"], "width": 2.6, "length": 1, "angle": 90, "softness": 0.5 },
        { "kind": "slab", "at": [[15.4, 16, 34]], "colors": ["@light"], "width": 0.8, "length": 1, "angle": 90, "opacity": 0.6, "clip": true },
        { "kind": "slab", "at": [[16.8, 16, 34]], "colors": ["@shadow"], "width": 0.8, "length": 1, "angle": 90, "opacity": 0.7, "clip": true }
      ]
    },
    "torch_top": {
      "$comment": "The torch's upper cell: the plain stick's top in a dark wrap, its tip 0.1 m over the cell's floor. No flame is painted: the flame is the flame effect drawn on billboards, rising from the tip (docs/LIGHTS.md §6, shared/look/flames.json baseM and baseWidthM).",
      "use": "block", "ramp": "bark", "alpha": "strokes", "wrap": false,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "slab", "at": [[16, 2.5, 5]], "colors": ["@base"], "width": 2.6, "length": 1, "angle": 90, "softness": 0.5 },
        { "kind": "slab", "at": [[15.4, 2.5, 5]], "colors": ["@light"], "width": 0.8, "length": 1, "angle": 90, "opacity": 0.6, "clip": true },
        { "kind": "slab", "at": [[16, 5, 3.5]], "colors": ["@shadow"], "width": 3.2, "length": 1, "angle": 90, "softness": 0.5 }
      ]
    },

    "cloth_canvas": {
      "$comment": "Thick canvas: a coarse weave of broad crossing slabs and a soft light along the top.",
      "use": "character", "ramp": "canvas", "overlay": 0.5,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "slab", "count": 9, "colors": ["@shadow"], "width": [3, 4], "length": [10, 14], "angle": 0, "angleJitter": 5, "opacity": 0.28 },
        { "kind": "slab", "count": 9, "colors": ["@light"], "width": [2.5, 3.5], "length": [10, 14], "angle": 90, "angleJitter": 5, "opacity": 0.28, "seed": 1 },
        { "kind": "edgeLight", "edge": "top", "color": "@light", "width": 3, "ragged": 1, "opacity": 0.4 }
      ]
    },
    "cloth_linen": { "$comment": "A light, cool tunic cloth that reads apart from sand and canvas.", "like": "cloth_canvas", "ramp": "linen", "overlay": 0.4 },
    "cloth_wool_red": {
      "$comment": "Soft wool or velvet (hoods, capes, cuffs): a few big soft shadow dabs and a sheen streak.",
      "use": "character", "ramp": "wool_red", "overlay": 0.35,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "dab", "count": 6, "colors": ["@shadow"], "width": [9, 12], "length": [12, 16], "angle": 80, "angleJitter": 20, "opacity": 0.35, "softness": 3 },
        { "kind": "streak", "count": 3, "colors": ["@light"], "width": [3, 4], "length": [14, 20], "angle": 75, "angleJitter": 8, "opacity": 0.35, "softness": 2, "seed": 1 }
      ]
    },
    "cloth_wool_blue": { "like": "cloth_wool_red", "ramp": "wool_blue" },
    "cloth_wool_green": { "like": "cloth_wool_red", "ramp": "wool_green" },
    "leather": {
      "use": "character", "ramp": "leather", "overlay": 0.45,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "streak", "count": 6, "colors": ["@shadow"], "width": [2, 3], "length": [14, 22], "angle": 0, "angleJitter": 10, "bend": [-1, 1], "opacity": 0.45 },
        { "kind": "streak", "count": 4, "colors": ["@light"], "width": [2, 3], "length": [10, 16], "angle": 0, "angleJitter": 10, "opacity": 0.45, "seed": 1 },
        { "kind": "edgeLight", "edge": "top", "color": "@light", "width": 2, "ragged": 0.6, "opacity": 0.5 }
      ]
    },
    "metal_iron": {
      "$comment": "Metal as broad painted light streaks on a dark-to-base gradient, never micro-scratches.",
      "use": "character", "ramp": "iron", "overlay": 0.7,
      "layers": [
        { "kind": "gradient", "from": "@shadow", "to": "@base", "direction": "up" },
        { "kind": "streak", "at": [[11, 16, 44], [22, 16, 30]], "colors": ["@light"], "width": [3, 5], "length": 1, "angle": 60, "opacity": 0.75, "softness": 1.5 },
        { "kind": "edgeLight", "edge": "top", "color": "@light", "width": 1.5, "opacity": 0.6 }
      ]
    },
    "metal_brass": { "like": "metal_iron", "ramp": "brass" },
    "fur_wolf": {
      "$comment": "Fur as tapered blades laid one way (the lie of the coat), not hairs.",
      "use": "character", "ramp": "wolf", "overlay": 0.6,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "blade", "count": 10, "colors": ["@shadow"], "width": [4, 5.5], "length": [9, 13], "angle": -100, "angleJitter": 12, "bend": [-2, 2], "opacity": 0.35, "softness": 1.5 },
        { "kind": "blade", "count": 7, "colors": ["@light"], "width": [3, 4], "length": [7, 10], "angle": -100, "angleJitter": 12, "bend": [-2, 2], "opacity": 0.4, "softness": 1.5, "seed": 1 }
      ]
    },
    "fur_wolf_belly": { "like": "fur_wolf", "ramp": "wolf_pale", "overlay": 0.5 },
    "fur_deer": { "like": "fur_wolf", "ramp": "deer", "overlay": 0.55 },
    "fur_deer_cream": { "like": "fur_wolf", "ramp": "deer_cream", "overlay": 0.45 },
    "antler": {
      "use": "character", "ramp": "antler", "overlay": 0.4,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "streak", "count": 5, "colors": ["@shadow"], "width": [2, 3], "length": [20, 28], "angle": 90, "angleJitter": 5, "opacity": 0.4 },
        { "kind": "streak", "count": 3, "colors": ["@light"], "width": [2, 3], "length": [16, 24], "angle": 90, "angleJitter": 5, "opacity": 0.5, "seed": 1 }
      ]
    },
    "skin_fair": {
      "$comment": "Skin stays nearly flat: one soft warm dab.",
      "use": "character", "ramp": "skin_fair", "overlay": 0.1,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "dab", "at": [[16, 16]], "colors": ["@light"], "width": 14, "length": 18, "opacity": 0.3, "softness": 6 }
      ]
    },
    "skin_tan": { "like": "skin_fair", "ramp": "skin_tan" },
    "skin_brown": { "like": "skin_fair", "ramp": "skin_brown" },
    "skin_deep": { "like": "skin_fair", "ramp": "skin_deep" },
    "hair_black": {
      "$comment": "Hair as a few long locks with one light streak.",
      "use": "character", "ramp": "hair_black", "overlay": 0.6,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "blade", "count": 10, "colors": ["@shadow"], "width": [4, 5], "length": [16, 22], "angle": -90, "angleJitter": 8, "bend": [-3, 3], "opacity": 0.5 },
        { "kind": "streak", "count": 3, "colors": ["@light"], "width": [2, 3], "length": [10, 16], "angle": 90, "angleJitter": 6, "opacity": 0.5, "seed": 1 }
      ]
    },
    "hair_brown": { "like": "hair_black", "ramp": "hair_brown" },
    "hair_ginger": { "like": "hair_black", "ramp": "hair_ginger" },
    "hair_blonde": { "like": "hair_black", "ramp": "hair_blonde" },

    "cloud_puff": {
      "$comment": "A sky accent (not yet drawn by the sky, which shades its clouds analytically): soft bright dabs over a cool underside.",
      "use": "sky", "ramp": "cloud", "overlay": 0.5,
      "layers": [
        { "kind": "fill", "color": "@base" },
        { "kind": "dab", "count": 5, "band": [0, 0.35], "colors": ["@shadow"], "width": [8, 12], "length": [12, 16], "angle": 0, "angleJitter": 15, "opacity": 0.45, "softness": 3 },
        { "kind": "dab", "count": 6, "band": [0.4, 1], "colors": ["@light"], "width": [10, 14], "length": [14, 18], "angle": 0, "angleJitter": 15, "opacity": 0.6, "softness": 3, "seed": 1 }
      ]
    }
  }
}
