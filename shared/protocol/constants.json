{
  "$comment": "Single source of truth for protocol constants (ARCHITECTURE.md §7.4, §8). Run `node shared/protocol/gen.mjs` after editing; CI fails if generated files are stale.",
  "protocolVersion": 1,
  "simHz": 60,
  "snapshotHz": 20,
  "maxDatagramBytes": 1200,
  "maxReliableMessageBytes": 1048576,
  "chunkSize": 32,
  "authDomainTag": "dwell-auth-v1",
  "limits": {
    "displayNameMaxBytes": 64,
    "clientVersionMaxBytes": 64,
    "serverNameMaxBytes": 64,
    "motdMaxBytes": 256,
    "rejectMessageMaxBytes": 256
  },
  "channels": {
    "control": 0,
    "world": 1
  },
  "messageTypes": {
    "DatagramPing": 2,
    "DatagramPong": 130,
    "StatusRequest": 64,
    "StatusResponse": 65,
    "ClientHello": 66,
    "Challenge": 67,
    "ClientAuth": 68,
    "Welcome": 69,
    "Reject": 70,
    "Ping": 71,
    "Pong": 72
  },
  "rejectReasons": {
    "ProtocolVersion": 1,
    "Banned": 2,
    "Full": 3,
    "NotAllowListed": 4,
    "AuthFailed": 5,
    "Malformed": 6
  },
  "transportKinds": {
    "WebTransport": 1,
    "WebRtc": 2,
    "Loopback": 3
  }
}
