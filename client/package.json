{
  "name": "@dwell/client",
  "version": "0.22.23",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:wasm": "cd .. && cargo build -p dwell-client --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir client/src/pkg target/wasm32-unknown-unknown/release/dwell_client.wasm",
    "e2e": "playwright test",
    "build:launcher": "vite build -c vite.launcher.config.ts",
    "site:fixture": "node --experimental-strip-types scripts/localSite.ts",
    "e2e:site": "npm run site:fixture && playwright test -c playwright.site.config.ts",
    "build:probe": "cd .. && cargo build -p dwell-client --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir crates/dwell-client/www/pkg target/wasm32-unknown-unknown/release/dwell_client.wasm",
    "e2e:webgpu": "playwright test -c playwright.webgpu.config.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "sfx:render": "node --experimental-strip-types scripts/renderSfx.ts"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
