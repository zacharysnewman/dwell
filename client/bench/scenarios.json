{
  "$comment": "Dev bench scenarios (docs/DEV_TOOLS.md; scripts/scenarios.ts describes the steps, scripts/bench.ts runs them). Each runs in a fresh local world: the player at the spawn, then the steps in order.",
  "scenarios": [
    {
      "name": "idle-spawn",
      "notes": "Standing at the spawn looking at the horizon once the LOD has loaded: the steady-state frame.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "mark" },
        { "do": "wait", "s": 5 },
        { "do": "record", "name": "steady" },
        { "do": "shot", "name": "steady" }
      ]
    },
    {
      "name": "fly-low-fast",
      "notes": "Flying fast (level 6, at least 88 m/s) about 15 m over the terrain (owner, 2026-10-14: the hitch seen when flying low): full-detail chunks streaming in as fast as the player moves. Heading +X (yaw 90) from the seed-7 spawn: a clear 1.7 km (flying is stopped by any ledge it hits: low enough to stream full-detail chunks, high enough not to snag).",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "fly", "on": true },
        { "do": "hold", "code": "Space", "s": 1.5 },
        { "do": "flySpeed", "level": 6 },
        { "do": "look", "yaw": 90, "pitch": 0 },
        { "do": "mark" },
        { "do": "traceStart" },
        { "do": "key", "code": "KeyW", "down": true },
        { "do": "wait", "s": 10 },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "traceStop", "name": "flight" },
        { "do": "record", "name": "flight" },
        { "do": "shot", "name": "flight-end" },
        { "do": "mark" },
        { "do": "settle", "maxS": 60 },
        { "do": "record", "name": "catch-up" }
      ]
    },
    {
      "name": "fly-low-faster",
      "notes": "Flying fast (level 8, at least 176 m/s) about 15 m over the terrain (owner, 2026-10-14: the hitch seen when flying low): full-detail chunks streaming in as fast as the player moves. Heading +X (yaw 90) from the seed-7 spawn: a clear 1.7 km (flying is stopped by any ledge it hits: low enough to stream full-detail chunks, high enough not to snag).",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "fly", "on": true },
        { "do": "hold", "code": "Space", "s": 1.5 },
        { "do": "flySpeed", "level": 8 },
        { "do": "look", "yaw": 90, "pitch": 0 },
        { "do": "mark" },
        { "do": "traceStart" },
        { "do": "key", "code": "KeyW", "down": true },
        { "do": "wait", "s": 10 },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "traceStop", "name": "flight" },
        { "do": "record", "name": "flight" },
        { "do": "shot", "name": "flight-end" },
        { "do": "mark" },
        { "do": "settle", "maxS": 60 },
        { "do": "record", "name": "catch-up" }
      ]
    },
    {
      "name": "jump-onto-block",
      "notes": "Places a block in front of the spawn, walks into it and jumps with forward held (owner, 2026-10-14: the jump usually failed to clear one block): the player should land on top (grounded 1 m up), then walk off its far side.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "select", "slot": 0 },
        { "do": "look", "yaw": 90, "pitch": -50 },
        { "do": "wait", "s": 0.3 },
        { "do": "edit", "action": "place" },
        { "do": "wait", "s": 0.5 },
        { "do": "look", "yaw": 90, "pitch": 0 },
        { "do": "mark" },
        { "do": "key", "code": "KeyW", "down": true },
        { "do": "wait", "s": 1.5 },
        { "do": "hold", "code": "Space", "s": 0.1 },
        { "do": "wait", "s": 1.5 },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "wait", "s": 0.5 },
        { "do": "record", "name": "jump" },
        { "do": "shot", "name": "after" }
      ]
    },
    {
      "name": "jump-in-place",
      "notes": "Jumps on flat ground at the spawn: the controller trace shows the jump's peak.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "mark" },
        { "do": "hold", "code": "Space", "s": 0.1 },
        { "do": "wait", "s": 1.5 },
        { "do": "record", "name": "jump" },
        { "do": "shot", "name": "landed" }
      ]
    },
    {
      "name": "look-horizon",
      "notes": "From the player's eyes at the spawn, looking along the ground 3° below the horizon (heading +X): grazing rays, a ray marcher's worst case (docs/RAY_MARCHED_RENDERER.md §5).",
      "split": "far",
      "steps": [
        { "do": "look", "yaw": 90, "pitch": -3 },
        { "do": "settle", "maxS": 120 },
        { "do": "mark" },
        { "do": "wait", "s": 5 },
        { "do": "record", "name": "steady" },
        { "do": "shot", "name": "horizon" }
      ]
    },
    {
      "name": "look-down",
      "notes": "From the player's eyes at the spawn, looking 80° down at the ground: short rays, a ray marcher's best case.",
      "split": "near",
      "steps": [
        { "do": "look", "yaw": 90, "pitch": -80 },
        { "do": "settle", "maxS": 120 },
        { "do": "mark" },
        { "do": "wait", "s": 5 },
        { "do": "record", "name": "steady" },
        { "do": "shot", "name": "down" }
      ]
    },
    {
      "name": "edit-burst",
      "notes": "Places and breaks a block in front of the spawn 150 times each (300 edits, about one per 0.12 s, just over the edit interval): the cost of remeshing and uploading edited chunks.",
      "split": "near",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "select", "slot": 0 },
        { "do": "look", "yaw": 90, "pitch": -50 },
        { "do": "wait", "s": 0.3 },
        { "do": "shot", "name": "before" },
        { "do": "mark" },
        {
          "do": "repeat",
          "times": 150,
          "steps": [
            { "do": "edit", "action": "place" },
            { "do": "wait", "s": 0.12 },
            { "do": "edit", "action": "break" },
            { "do": "wait", "s": 0.12 }
          ]
        },
        { "do": "record", "name": "burst" },
        { "do": "shot", "name": "after" }
      ]
    },
    {
      "name": "fly-high",
      "notes": "Flies up about 540 m (level 8 for 3 s), looks out and down 20° and flies +X for 10 s: far terrain, the LOD's distant levels streaming.",
      "split": "far",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "fly", "on": true },
        { "do": "flySpeed", "level": 8 },
        { "do": "hold", "code": "Space", "s": 3 },
        { "do": "look", "yaw": 90, "pitch": -20 },
        { "do": "settle", "maxS": 120 },
        { "do": "mark" },
        { "do": "shot", "name": "high" },
        { "do": "key", "code": "KeyW", "down": true },
        { "do": "wait", "s": 10 },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "record", "name": "flight" },
        { "do": "shot", "name": "flight-end" }
      ]
    },
    {
      "name": "thermal-10min",
      "notes": "Phone-oriented: ten minutes of flight 60 m up at level 4 (at least 44 m/s) round a 660 m square, for thermal throttling: the last minute's frame intervals against the first's. Run it on a phone (or with the device's own heat in mind); it takes over ten minutes.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "fly", "on": true },
        { "do": "flySpeed", "level": 4 },
        { "do": "hold", "code": "Space", "s": 1.5 },
        { "do": "look", "yaw": 90, "pitch": -10 },
        { "do": "shot", "name": "start" },
        { "do": "mark" },
        { "do": "key", "code": "KeyW", "down": true },
        {
          "do": "repeat",
          "times": 1,
          "steps": [
            { "do": "look", "yaw": 90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 180, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": -90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 0, "pitch": -10 },
            { "do": "wait", "s": 15 }
          ]
        },
        { "do": "record", "name": "first-minute" },
        {
          "do": "repeat",
          "times": 8,
          "steps": [
            { "do": "look", "yaw": 90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 180, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": -90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 0, "pitch": -10 },
            { "do": "wait", "s": 15 }
          ]
        },
        { "do": "mark" },
        {
          "do": "repeat",
          "times": 1,
          "steps": [
            { "do": "look", "yaw": 90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 180, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": -90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 0, "pitch": -10 },
            { "do": "wait", "s": 15 }
          ]
        },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "record", "name": "last-minute" },
        { "do": "shot", "name": "end" }
      ]
    },
    {
      "name": "sprint-straight",
      "notes": "Sprints (Shift + W) along +X from the seed-7 spawn (Phase 29 motion effects): the FOV widens by the sprint boost and faint wind streaks show at the screen's edges; a shot standing, mid-sprint, then standing again.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "look", "yaw": 90, "pitch": 0 },
        { "do": "shot", "name": "still" },
        { "do": "mark" },
        { "do": "key", "code": "ShiftLeft", "down": true },
        { "do": "key", "code": "KeyW", "down": true },
        { "do": "wait", "s": 1.5 },
        { "do": "shot", "name": "sprint" },
        { "do": "wait", "s": 1 },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "key", "code": "ShiftLeft", "down": false },
        { "do": "record", "name": "sprint" },
        { "do": "wait", "s": 2 },
        { "do": "shot", "name": "after" }
      ]
    },
    {
      "name": "fly-fast-turn",
      "notes": "Flies fast (level 8 with Run: the terrain band's 400 m/s cap) from the seed-7 spawn, then turns and dives (Phase 29 motion effects): the strong flight streaks, and the vanishing point following the direction of travel as the view turns away from it.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "fly", "on": true },
        { "do": "hold", "code": "Space", "s": 2 },
        { "do": "flySpeed", "level": 8 },
        { "do": "look", "yaw": 90, "pitch": 0 },
        { "do": "mark" },
        { "do": "key", "code": "ShiftLeft", "down": true },
        { "do": "key", "code": "KeyW", "down": true },
        { "do": "wait", "s": 2.5 },
        { "do": "shot", "name": "fast" },
        { "do": "look", "yaw": 65, "pitch": -8 },
        { "do": "wait", "s": 0.15 },
        { "do": "shot", "name": "turn" },
        { "do": "look", "yaw": 90, "pitch": -30 },
        { "do": "wait", "s": 0.3 },
        { "do": "shot", "name": "dive" },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "key", "code": "ShiftLeft", "down": false },
