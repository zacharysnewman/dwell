          "do": "camera",
          "position": [0, 1000, 0],
          "yaw": 112.5,
          "pitch": -25,
          "aroundPlayer": true
        },
        { "do": "settle", "maxS": 120 },
        { "do": "shot", "name": "high-1000" }
