{
  "$comment": "Dev bench scenarios (docs/DEV_TOOLS.md; scripts/scenarios.ts describes the steps, scripts/bench.ts runs them). Each runs in a fresh local world: the player at the spawn, then the steps in order.",
  "scenarios": [
    {
      "name": "idle-spawn",
      "notes": "Standing at the spawn looking at the horizon once the LOD has loaded: the steady-state frame.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "mark" },
        { "do": "wait", "s": 5 },
        { "do": "record", "name": "steady" },
        { "do": "shot", "name": "steady" }
      ]
    },
    {
      "name": "fly-low-fast",
      "notes": "Flying fast (level 6, at least 88 m/s) about 15 m over the terrain (owner, 2026-10-14: the hitch seen when flying low): full-detail chunks streaming in as fast as the player moves. Heading +X (yaw 90) from the seed-7 spawn: a clear 1.7 km (flying is stopped by any ledge it hits: low enough to stream full-detail chunks, high enough not to snag).",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "fly", "on": true },
        { "do": "hold", "code": "Space", "s": 1.5 },
        { "do": "flySpeed", "level": 6 },
        { "do": "look", "yaw": 90, "pitch": 0 },
        { "do": "mark" },
        { "do": "traceStart" },
        { "do": "key", "code": "KeyW", "down": true },
        { "do": "wait", "s": 10 },
        { "do": "key", "code": "KeyW", "down": false },
        { "do": "traceStop", "name": "flight" },
        { "do": "record", "name": "flight" },
        { "do": "shot", "name": "flight-end" },
        { "do": "mark" },
        { "do": "settle", "maxS": 60 },
        { "do": "record", "name": "catch-up" }
      ]
    },
    {
      "name": "fly-low-faster",
