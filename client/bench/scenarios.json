    {
      "name": "thermal-10min",
      "notes": "Phone-oriented: ten minutes of flight 60 m up at level 4 (at least 44 m/s) round a 660 m square, for thermal throttling: the last minute's frame intervals against the first's. Run it on a phone (or with the device's own heat in mind); it takes over ten minutes.",
      "steps": [
        { "do": "settle", "maxS": 120 },
        { "do": "fly", "on": true },
        { "do": "flySpeed", "level": 4 },
        { "do": "hold", "code": "Space", "s": 1.5 },
