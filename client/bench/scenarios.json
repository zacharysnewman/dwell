        { "do": "shot", "name": "start" },
        { "do": "mark" },
        { "do": "key", "code": "KeyW", "down": true },
        {
          "do": "repeat",
          "times": 1,
          "steps": [
            { "do": "look", "yaw": 90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 180, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": -90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 0, "pitch": -10 },
            { "do": "wait", "s": 15 }
