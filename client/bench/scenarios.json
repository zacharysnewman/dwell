        { "do": "shot", "name": "horizon" }
      ]
    },
    {
      "name": "look-down",
      "notes": "From the player's eyes at the spawn, looking 80° down at the ground: short rays, a ray marcher's best case.",
      "split": "near",
      "steps": [
        { "do": "look", "yaw": 90, "pitch": -80 },
        { "do": "settle", "maxS": 120 },
        { "do": "mark" },
        { "do": "wait", "s": 5 },
        { "do": "record", "name": "steady" },
