            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 0, "pitch": -10 },
            { "do": "wait", "s": 15 }
          ]
        },
        { "do": "mark" },
        {
          "do": "repeat",
          "times": 1,
          "steps": [
            { "do": "look", "yaw": 90, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": 180, "pitch": -10 },
            { "do": "wait", "s": 15 },
            { "do": "look", "yaw": -90, "pitch": -10 },
