{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "vite.config.ts",
    "vite.launcher.config.ts",
    "playwright.config.ts",
    "playwright.site.config.ts",
    "playwright.webgpu.config.ts",
    "e2e",
    "e2e-webgpu",
    "scripts"
  ]
}
